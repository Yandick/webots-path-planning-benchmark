# Autonomous Mobile Robot
DEF ROBOT Robot {
  translation -4.0 -4.0 0.05
  rotation 0 0 1 0.785398
  children [
    # Chassis
    Transform {
      translation 0 0 0.02
      children [
        DEF CHASSIS_SHAPE Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.7 0.95
            roughness 0.3
            metalness 0.2
          }
          geometry Cylinder {
            height 0.06
            radius 0.18
          }
        }
      ]
    }
    # Heading Indicator Arrow / Top cap
    Transform {
      translation 0.08 0 0.055
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.2 0.3
            roughness 0.3
          }
          geometry Box {
            size 0.08 0.04 0.01
          }
        }
      ]
    }
    # Sensors
    GPS {
      name "gps"
    }
    Compass {
      name "compass"
    }
    InertialUnit {
      name "inertial_unit"
    }
    Transform {
      translation 0 0 0.08
      children [
        Lidar {
          name "lidar"
          horizontalResolution 360
          numberOfLayers 1
          minRange 0.22
          maxRange 6.0
          fieldOfView 6.2831853
          defaultFrequency 20
        }
      ]
    }
    # Left Wheel Motor & Sensor
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0.15 0
      }
      device [
        RotationalMotor {
          name "left wheel motor"
          maxVelocity 10.0
        }
        PositionSensor {
          name "left wheel sensor"
        }
      ]
      endPoint Solid {
        translation 0 0.15 0
        rotation 1 0 0 1.5708
        children [
          DEF WHEEL_SHAPE Shape {
            appearance PBRAppearance {
              baseColor 0.1 0.1 0.1
              roughness 0.8
            }
            geometry Cylinder {
              height 0.025
              radius 0.05
            }
          }
        ]
        name "wheel_left"
        boundingObject Cylinder {
          height 0.025
          radius 0.05
        }
        physics Physics {
          density 1000
        }
      }
    }
    # Right Wheel Motor & Sensor
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 -0.15 0
      }
      device [
        RotationalMotor {
          name "right wheel motor"
          maxVelocity 10.0
        }
        PositionSensor {
          name "right wheel sensor"
        }
      ]
      endPoint Solid {
        translation 0 -0.15 0
        rotation 1 0 0 1.5708
        children [
          USE WHEEL_SHAPE
        ]
        name "wheel_right"
        boundingObject Cylinder {
          height 0.025
          radius 0.05
        }
        physics Physics {
          density 1000
        }
      }
    }
  ]
  boundingObject Group {
    children [
      Transform {
        translation 0 0 0.02
        children [
          Cylinder {
            height 0.06
            radius 0.18
          }
        ]
      }
      Transform {
        translation 0.13 0 -0.03
        children [
          Sphere {
            radius 0.02
          }
        ]
      }
      Transform {
        translation -0.13 0 -0.03
        children [
          Sphere {
            radius 0.02
          }
        ]
      }
    ]
  }
  physics Physics {
    mass 3.0
  }
  name "robot"
  controller "robot_navigator"
}

# Supervisor Controller (Manages dynamic obstacles & benchmark statistics)
DEF SUPERVISOR Robot {
  name "supervisor"
  controller "robot_supervisor"
  supervisor TRUE
}

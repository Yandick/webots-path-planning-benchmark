#VRML_SIM R2025a utf8

WorldInfo {
  basicTimeStep 32
  coordinateSystem "ENU"
  lineScale 0.1
}

Viewpoint {
  orientation 0.25 0.22 0.94 1.85
  position -8.5 -8.5 11.0
  fieldOfView 0.8
}

DirectionalLight {
  direction 0.4 0.4 -1
  intensity 1.2
  castShadows TRUE
}

DirectionalLight {
  direction -0.4 -0.4 -1
  intensity 0.5
}

# Ground Floor
Solid {
  translation 0 0 -0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.88 0.88 0.88
        roughness 0.6
        metalness 0.1
      }
      geometry Box {
        size 10.2 10.2 0.1
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 10.2 10.2 0.1
  }
}

